{
  "$schema": "https://framework-1258016615.tcloudbaseapp.com/schema/latest.json",
  "version": "2.0",
  "envId": "gn-261014090703-4532-d1ae91379d6",
  "framework": {
    "name": "moji-tech-blog",
    "plugins": {
      "backend": {
        "use": "@cloudbase/framework-plugin-container",
        "inputs": {
          "serviceName": "moji-backend",
          "servicePath": "/backend",
          "dockerfilePath": "./backend/Dockerfile",
          "buildDir": "./backend",
          "containerPort": 3000,
          "cpu": 0.5,
          "mem": 1,
          "minNum": 0,
          "maxNum": 2,
          "policyThreshold": 60,
          "customLogs": "stdout",
          "envVariables": {
            "NODE_ENV": "production",
            "PORT": "3000",
            "API_PREFIX": "/api",
            "CORS_ORIGIN": "https://YOUR-FRONTEND-DOMAIN"
          }
        }
      },
      "frontend": {
        "use": "@cloudbase/framework-plugin-website",
        "inputs": {
          "outputPath": "frontend/dist",
          "cloudPath": "/",
          "ignore": [".git", "node_modules", "**/*.map"],
          "errorDocument": "index.html",
          "indexDocument": "index.html"
        }
      }
    }
  }
}
