# ============================================================
# 墨迹博客 · 前端构建期环境变量示例
#
# 复制为 frontend/.env 后填入真实值（该文件已被 .gitignore 忽略）。
# 这些变量由 vite.config.ts 在构建时注入到产物中。
#
# 注意：VITE_ 前缀的变量会打进前端产物，这是 TCB 前端 SDK 的设计
# （publish key 是受限的匿名令牌）。切勿把数据库管理密钥等走此处。
# ============================================================

VITE_CLOUDBASE_ENV_ID=
VITE_CLOUDBASE_REGION=ap-shanghai
VITE_CLOUDBASE_PUBLISH_KEY=
VITE_OAUTH_RELAY_URL=
